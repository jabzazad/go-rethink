# Copy to .env and fill in. Real environment variables override .env.
PORT=8080

# LINE Messaging API (LINE Developers console > your channel)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Gemini, the AI responder (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# USD per 1M tokens, used for the cost columns. Check current prices for your model.
GEMINI_PRICE_INPUT_PER_M=0.30
GEMINI_PRICE_OUTPUT_PER_M=2.50
# 0 = no thinking (fastest/cheapest for chat). -1 = model default.
GEMINI_THINKING_BUDGET=0

# Jev (TypeSafe), the primary decider, called through Vercel AI Gateway.
# Leave empty to use Rethink only. Key: Vercel dashboard > AI Gateway > API keys.
AI_GATEWAY_API_KEY=
JEV_URL=https://ai-gateway.vercel.sh/v1/evaluate
JEV_MODEL=typesafe-ai/jev
# TypeSafe direct instead: JEV_API_KEY=..., JEV_URL=https://api.typesafe.ai/v1/systemone, JEV_MODEL=jev-latest
# Bot answers only when Jev's confidence >= this, otherwise escalate to AI.
JEV_MIN_CONFIDENCE=0.6
# Only used if the response has no billed cost (Vercel returns the real cost).
JEV_PRICE_INPUT_PER_M=0.042
JEV_TIMEOUT_MS=3000

# Who drives replies: swap (alternate Jev/Rethink every SWAP_INTERVAL), jev, or rethink.
# The other decider always runs as an async shadow, so both get scored either way.
DECIDER_MODE=swap
SWAP_INTERVAL=1m

# Rethink, the local fallback decider: abstain (escalate to AI) below this calibrated confidence.
RETHINK_MIN_CONFIDENCE=0.65

# Keyword baseline: a keyword must cover at least this share of the message.
KEYWORD_MIN_STRENGTH=0.3

# Rich menu image: a Thai-capable font for the generated image, or your own 2500x1686 image.
RICHMENU_FONT=C:\Windows\Fonts\LeelawUI.ttf
# RICHMENU_IMAGE=./my-menu.png

# MongoDB (docker compose up -d mongo). Inside compose the gateway uses mongodb://mongo:27017.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=decision_gateway

# Cap on calls per minute to the decision model (0 = none). Vercel free tier: 5/min.
JEV_MAX_RPM=0

# Dashboard login for everything except /webhook. Set this before sharing the ngrok URL.
DASHBOARD_USER=team
DASHBOARD_PASSWORD=
